NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=file:./nexusssh.db
REDIS_URL=redis://127.0.0.1:6379
ENCRYPTION_KEY_PROVIDER=environment
ENCRYPTION_KEY=
SESSION_SECRET=
INTERNAL_SECRET=
SETUP_TOKEN=
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=nexusssh
MCP_PUBLIC_URL=http://localhost:3002/mcp
MCP_AUTH_ISSUER=http://localhost:3000
INTERNAL_API_URL=http://127.0.0.1:3001
API_PORT=3001
MCP_PORT=3002
# Explicit approved destination networks, comma-separated. No destinations allowed until configured.
SSH_ALLOWED_CIDRS=192.0.2.0/24
SSH_CONNECT_TIMEOUT=10000
SSH_IDLE_TIMEOUT=300000
SSH_MAX_SESSIONS=20
SSH_OUTPUT_LIMIT=1048576
AUDIT_RETENTION_DAYS=90
LOG_LEVEL=info
